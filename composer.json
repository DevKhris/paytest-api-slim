{
    "name": "paytest/api-slim",
    "description": "PayTest Backend API - Sistema de simulación de pagos",
    "type": "project",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^6.4",
        "firebase/php-jwt": "^6.10",
        "symfony/uid": "^6.4",
        "ramsey/uuid": "^4.7",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "PayTest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayTest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "start": "php -S localhost:8080 -t public"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
