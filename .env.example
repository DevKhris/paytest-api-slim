APP_ENV=development
APP_DEBUG=true
APP_NAME=PayTest API

# Database
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=paytest
DB_USERNAME=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=86400

# Logging
LOG_LEVEL=debug
LOG_PATH=./logs/app.log
